# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# --- Supabase (públicas: llegan al navegador; RLS protege los datos) ---------
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la app; se usa en los enlaces de confirmación de correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo servidor: integraciones opcionales (nunca con prefijo NEXT_PUBLIC_) -
# Sin estas variables la app funciona; Ajustes → Integraciones dice qué falta.

# Asistente de IA. Con una sola clave se usa ese proveedor; con las dos, elige
# con AI_PROVIDER (anthropic | openai). "fake" = respuestas de prueba, solo
# en desarrollo y E2E.
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# Opcional; por defecto claude-opus-5-5.
# ANTHROPIC_MODEL=
# OPENAI_API_KEY=
# Obligatorio si usas OpenAI.
# OPENAI_MODEL=

# Notion (integración pública OAuth). Redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/integrations/notion/callback
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# Clave secreta de Supabase (sb_secret_...): guarda el estado de las
# integraciones y los tokens cifrados. Solo servidor.
# SUPABASE_SECRET_KEY=
# 32 bytes en base64 para cifrar los tokens: openssl rand -base64 32
# INTEGRATIONS_ENCRYPTION_KEY=

# --- Pruebas (en .env.test.local) -----------------------------------------
# Usuarios confirmados del proyecto de desarrollo para Vitest (RLS) y Playwright.
# E2E_USER_A_EMAIL=
# E2E_USER_A_PASSWORD=
# E2E_USER_B_EMAIL=
# E2E_USER_B_PASSWORD=
