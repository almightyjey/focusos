# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# --- Supabase (públicas: llegan al navegador; RLS protege los datos) ---------
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la app; se usa en los enlaces de confirmación de correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo servidor (todavía no se usan; reservadas para fases siguientes) ----
# Clave secreta de Supabase (sb_secret_...). Jamás con prefijo NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# Integraciones opcionales (fase 9)
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Pruebas (en .env.test.local) -----------------------------------------
# Usuarios confirmados del proyecto de desarrollo para Vitest (RLS) y Playwright.
# E2E_USER_A_EMAIL=
# E2E_USER_A_PASSWORD=
# E2E_USER_B_EMAIL=
# E2E_USER_B_PASSWORD=
